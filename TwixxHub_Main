                local toast = new("Frame", {
                    AnchorPoint = Vector2.new(1, 1),
                    Position = UDim2.new(1, -14, 1, 70),
                    Size = UDim2.fromOffset(260, 52),
                    BackgroundColor3 = TOAST_BG, BackgroundTransparency = 0.05,
                    BorderSizePixel = 0, ZIndex = 50,
                }, gui)
                corner(toast, 10)
                accentStroke(toast, 1.5, 0.1)
                local bar = new("Frame", {
