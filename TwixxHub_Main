                task.wait(0.35)
                toast:Destroy()
                task.wait(0.15)
            end
            toastRunning = false
        end)
    end

    -- Feed rows
    local ageLabels = {}
    local hidden    = {}
    local latest    = {}
    local prevKeys  = {}

    local function keyOf(e) return e.jobId .. "|" .. e.name .. "|" .. tostring(e.ts) end

    local function subText(entry)
        local parts = { formatAge(entry.ts) }
        local rarityText = escapeRich(entry.rarity or "Unknown")
        if entry.rarityColor then
            rarityText = ('<font color="%s">%s</font>'):format(richColor(entry.rarityColor), rarityText)
        end
        table.insert(parts, rarityText)
        return table.concat(parts, " • ")
    end

    local function clearRows()
        for _, c in ipairs(feed:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        table.clear(ageLabels)
    end

    local function addRow(data, order)
        local row = new("Frame", {
            LayoutOrder = order, Size = UDim2.new(1, 0, 0, 62),
            BackgroundColor3 = WHITE, BackgroundTransparency = 0.07, BorderSizePixel = 0,
        }, feed)
        corner(row, 12)
        gradient(row, Color3.fromRGB(9, 32, 88), Color3.fromRGB(6, 14, 42), 0)
        accentStroke(row, 1, 0.5)

        local bar = new("Frame", {
            Position = UDim2.fromOffset(6, 8), Size = UDim2.fromOffset(4, 46),
            BackgroundColor3 = WHITE, BorderSizePixel = 0,
        }, row)
        corner(bar, 2)
        if data.rarityColor then bar.BackgroundColor3 = data.rarityColor
        else gradient(bar, ACCENT_HI, ACCENT_DARK, 90) end

        new("ImageLabel", {
            Position = UDim2.fromOffset(18, 9), Size = UDim2.fromOffset(44, 44),
            BackgroundTransparency = 1,
            Image = data.iconId and ("rbxassetid://" .. tostring(data.iconId)) or "",
            ScaleType = Enum.ScaleType.Fit,
        }, row)

        local titleLbl2 = label(row, "", 17, FONT_BOLD, WHITE,
            UDim2.fromOffset(70, 7), UDim2.new(1, -232, 0, 26))
        titleLbl2.RichText = true; titleLbl2.TextScaled = true
        new("UITextSizeConstraint", { MaxTextSize = 17, MinTextSize = 8 }, titleLbl2)
        titleLbl2.Text = ('%s  <font color="rgb(110,210,255)">[ %s ]</font>'):format(
            escapeRich(data.name), formatValue(data.value))

        local sub = label(row, "", 10, FONT_BOLD, SUB_TEXT,
            UDim2.fromOffset(70, 34), UDim2.new(1, -232, 0, 18))
        sub.RichText = true; sub.TextTruncate = Enum.TextTruncate.AtEnd
        sub.Text = subText(data)
        table.insert(ageLabels, { label = sub, entry = data })

        local join, _ = button(row, {
            text = "JOIN", textSize = 8,
            anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -82, 0.5, 0),
            size = UDim2.fromOffset(50, 26),
            c0 = ACCENT, c1 = ACCENT_DARK,
            strokeColor = ACCENT_HI, strokeTransparency = 0.2,
        })

        local selected = autoForceState and forceKey == keyOf(data)
        local fc0  = selected and ACCENT_HI or (autoForceState and Color3.fromRGB(10,40,100) or Color3.fromRGB(20,30,60))
        local fc1  = selected and ACCENT     or (autoForceState and Color3.fromRGB(6,16,46)  or Color3.fromRGB(14,22,46))
        local fclr = selected and WHITE or (autoForceState and WHITE or Color3.fromRGB(55,90,140))
        local force, _ = button(row, {
            text = "FORCE", textSize = 8, textColor = fclr,
            anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -14, 0.5, 0),
            size = UDim2.fromOffset(46, 26),
            c0 = fc0, c1 = fc1,
            strokeColor = selected and WHITE or ACCENT,
            strokeTransparency = selected and 0.3 or 0.5,
        })

        local blBtn, _ = button(row, {
            text = "BL", textSize = 8,
            anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -138, 0.5, 0),
            size = UDim2.fromOffset(30, 26),
            c0 = Color3.fromRGB(20, 54, 128), c1 = Color3.fromRGB(10, 30, 85),
            strokeColor = ACCENT, strokeTransparency = 0.3,
        })

        join.MouseButton1Click:Connect(function() joinServer(data.jobId) end)
        force.MouseButton1Click:Connect(function()
            if not autoForceState then return end
            if forceKey == keyOf(data) then stopForce() else startForce(keyOf(data), data.jobId) end
            render()
        end)
        blBtn.MouseButton1Click:Connect(function()
            if data.name and data.name ~= "" then
                blacklist[data.name] = true; saveBlacklist()
                statusLabel.Text = "Blacklisted: " .. tostring(data.name):sub(1, 18)
                render()
            end
        end)

        if blacklistMode then
            local pick = new("TextButton", {
                AutoButtonColor = false, Text = "TAP TO BLACKLIST",
                TextSize = 11, Font = FONT_BOLD, TextColor3 = WHITE,
                Size = UDim2.fromScale(1, 1),
                BackgroundColor3 = Color3.fromRGB(30, 90, 210),
                BackgroundTransparency = 0.3, ZIndex = 5, BorderSizePixel = 0,
            }, row)
            pick.MouseButton1Click:Connect(function()
                if data.name and data.name ~= "" then
                    blacklist[data.name] = true; saveBlacklist()
                    blacklistMode = false
                    statusLabel.Text = "Blacklisted: " .. tostring(data.name):sub(1, 18)
                    render()
                end
            end)
        end
    end

    -- Render
    render = function()
        local scroll = feed.CanvasPosition
        clearRows()
        local shown = 0
        for _, e in ipairs(latest) do
            if not hidden[keyOf(e)] and not isBlacklisted(e) then
                local rarityOk = filterRarity == "All"
                    or (e.rarity and e.rarity:lower():find(filterRarity:lower()))
                local valueOk = e.value >= filterMinValue
                if rarityOk and valueOk then
                    shown += 1
                    if shown <= MAX_ITEMS then addRow(e, shown) end
                end
            end
        end
        detectedLabel.Text = shown .. " detected"
        feed.CanvasPosition = scroll

        if autoJoinState and #latest > 0 then
            for _, e in ipairs(latest) do
                local jid = tostring(e.jobId)
                if not hidden[keyOf(e)] and not isBlacklisted(e)
                    and jid ~= tostring(game.JobId) and jid ~= lastAutoJoinJob then
                    lastAutoJoinJob = jid
                    joinServer(jid)
                    break
                end
            end
        end
    end

    -- Button wiring
    clearBtn.MouseButton1Click:Connect(function()
        for _, e in ipairs(latest) do hidden[keyOf(e)] = true end; render()
    end)
    blClose.MouseButton1Click:Connect(function()
        blPanel.Visible = false; showingBlacklistPanel = false
    end)
    blModeBtn.MouseButton1Click:Connect(function()
        blacklistMode = not blacklistMode
        blPanel.Visible = false; showingBlacklistPanel = false
        blModeBtn.Text = blacklistMode and "Pick log..." or "Blacklist"
        statusLabel.Text = blacklistMode and "Click a log to blacklist" or "Connected"
        render()
    end)
    unblBtn.MouseButton1Click:Connect(function()
        blacklistMode = false; blModeBtn.Text = "Blacklist"
        showingBlacklistPanel = not showingBlacklistPanel
        blPanel.Visible = showingBlacklistPanel
        if showingBlacklistPanel then
            refreshBlacklistPanel(); statusLabel.Text = "Blacklist manager"
            autoExecPanel.Visible = false
        else
            statusLabel.Text = "Connected"
        end
    end)
    autoExecSideBtn.MouseButton1Click:Connect(function()
        blPanel.Visible = false; showingBlacklistPanel = false
        autoExecPanel.Visible = not autoExecPanel.Visible
        statusLabel.Text = autoExecPanel.Visible and "Auto Execute settings" or "Connected"
    end)

    -- fetchPets defined BEFORE any task.spawn that calls it
    local function fetchPets()
        local body = httpGet(API_URL)
        if not body then return false end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or type(decoded) ~= "table" then return false end
        local list = {}
        for _, p in ipairs(decoded) do
            if p.petName and p.jobId and tonumber(p.value) then
                local name   = tostring(p.petName)
                local rarity = getRarity(name) or (p.rarity and tostring(p.rarity)) or DEFAULT_RARITY
                table.insert(list, {
                    name        = name,
                    value       = tonumber(p.value),
                    jobId       = tostring(p.jobId),
                    iconId      = p.iconId,
                    key         = tostring(p.jobId) .. "|" .. name .. "|" .. tostring(p.timestamp),
                    ts          = tonumber(p.timestamp) or (os.time() * 1000),
                    rarity      = rarity,
                    rarityColor = getRarityColor(name),
                })
            end
        end
        table.sort(list, function(a, b) return (a.ts or 0) > (b.ts or 0) end)
        latest = list
        return true
    end

    -- Auto poster
    local postedAt       = {}
    local postOk, postFail, scanCount, lastPostStatus = 0, 0, 0, "-"
    local postPauseUntil = 0
    local UNIT_MUL = { K = 1e3, M = 1e6, B = 1e9, T = 1e12 }

    local function parseValue(text)
        local clean = tostring(text):gsub("<[^>]+>", "")
        local num, unit = clean:match("^%s*%$?%s*([%d%.,]+)%s*([KkMmBbTt]?)%s*/%s*[sS]%s*$")
        if not num then return nil end
        local n = tonumber((num:gsub(",", "")))
        if not n then return nil end
        return n * (UNIT_MUL[unit:upper()] or 1)
    end

    local function resolveName(inst)
        local cur = inst.Parent
        for _ = 1, 8 do
            if not cur or cur == workspace then return nil end
            local key = displayByName[cur.Name] and cur.Name or nil
            if not key then
                for _, ch in ipairs(cur:GetChildren()) do
                    if ch:IsA("TextLabel") then
                        local t = tostring(ch.Text):gsub("<[^>]+>", ""):match("^%s*(.-)%s*$")
                        if displayByName[t] then key = t; break end
                    end
                end
            end
            if key then return displayByName[key], iconByName[key] end
            cur = cur.Parent
        end
        return nil
    end

    local function scanPets()
        local found, seen, n = {}, {}, 0
        for _, d in ipairs(workspace:GetDescendants()) do
            n += 1
            if n % 3000 == 0 then task.wait() end
            if d:IsA("TextLabel") then
                local value = parseValue(d.Text)
                if value and value >= POST_MIN_VALUE then
                    local name, icon = resolveName(d)
                    if name then
                        local k = name .. "|" .. math.floor(value)
                        if not seen[k] then
                            seen[k] = true
                            table.insert(found, { name = name, value = value, icon = icon })
                        end
                    end
                end
            end
        end
        return found
    end

    local function alreadyListed(name, value)
        for _, e in ipairs(latest) do
            if e.jobId == game.JobId and e.name == name
                and math.abs(e.value - value) <= value * 0.05 then
                return true
            end
        end
        return false
    end

    -- Background tasks
    task.spawn(function()
        while gui.Parent do
            if not AUTO_POST or game.JobId == "" then
                postLabel.Text = "Post: disabled"
            elseif os.clock() >= postPauseUntil then
                local ok, found = pcall(scanPets)
                if ok then
                    scanCount = #found
                    for _, pet in ipairs(found) do
                        local key  = game.JobId .. "|" .. pet.name .. "|" .. math.floor(pet.value)
                        local last = postedAt[key]
                        if (not last or os.clock() - last > POST_COOLDOWN)
                            and not alreadyListed(pet.name, pet.value) then
                            postedAt[key] = os.clock()
                            local body = HttpService:JSONEncode({
                                petName = pet.name, value = pet.value,
                                jobId = game.JobId,
                                iconId = pet.icon and tostring(pet.icon) or "",
                                timestamp = os.time() * 1000,
                            })
                            local status, _ = httpPost(POST_URL, body)
                            if status and status >= 200 and status < 300 then
                                postOk += 1
                            else
                                postFail += 1
                                postedAt[key] = os.clock() - POST_COOLDOWN + 60
                                if status == 429 then postPauseUntil = os.clock() + 30 end
                            end
                            lastPostStatus = status and tostring(status) or "err"
                            if status == 429 then break end
                            task.wait(0.5)
                        end
                    end
                else
                    warn("[" .. TITLE .. "] Scan error:", found)
                end
                postLabel.Text = ("Scan:%d Post:%d/%d (%s)"):format(
                    scanCount, postOk, postOk + postFail, lastPostStatus)
            end
            task.wait(POST_SCAN_INTERVAL)
        end
    end)

    task.spawn(function()
        while gui.Parent do
            for _, item in ipairs(ageLabels) do
                if item.label.Parent then item.label.Text = subText(item.entry) end
            end
            task.wait(1)
        end
    end)

    task.spawn(function()
        while gui.Parent do
            local ok = fetchPets()
            for _, e in ipairs(latest) do
                local k = keyOf(e)
                if not prevKeys[k] then
                    prevKeys[k] = true
                    sessionPetsFound += 1
                    statPetsLabel.Text = "Pets Found: " .. sessionPetsFound
                    showToast(e.name, e.value)
                end
            end
            statusLabel.Text = ok and "Connected" or "Disconnected"
            if ok then render() end
            task.wait(REFRESH_INTERVAL)
        end
    end)

    -- Auto Execute on join
    task.spawn(function()
        task.wait(3)
        if autoExecEnabled and autoExecUrl ~= "" then
            local code = httpGet(autoExecUrl)
            if code then
                local fn, err = loadstring(code)
                if fn then
                    pcall(fn)
                    statusLabel.Text = "AutoExec: ran on join ✓"
                else
                    warn("[Twixx Hub] AutoExec compile error:", err)
                end
            end
        end
    end)

    print("[" .. TITLE .. "] Hub loaded 🔥")
end

