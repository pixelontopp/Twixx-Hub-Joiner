    local function joinServer(jobId)
        jobId = tostring(jobId or "")
        if jobId == "" or jobId == "nil" then
            warn("[" .. TITLE .. "] Join failed: empty jobId"); return
        end
        if jobId == tostring(game.JobId) then
            warn("[" .. TITLE .. "] Already in this server"); return
        end
        statusLabel.Text = "Joining..."
        sessionJoins += 1
        statJoinsLabel.Text = "Joins: " .. sessionJoins
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player)
        end)
        if ok then return end
        ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId)
        end)
        if ok then return end
        local fn = (syn and syn.request) or http_request or request
        if fn then
            pcall(fn, {
                Url = "https://gamejoin.roblox.com/v1/join-game-instance",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json", ["User-Agent"] = "Roblox/WinInet" },
                Body = HttpService:JSONEncode({ placeId = game.PlaceId, gameId = jobId }),
            })
            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, player)
            end)
        else
            statusLabel.Text = "Join failed"
        end
    end

    stopForce = function()
        forceRun += 1; forceKey = nil; forceJobId = nil
    end
    startForce = function(key, jobId)
        forceRun += 1
        local myRun = forceRun
        forceKey = key; forceJobId = jobId
        task.spawn(function()
            while forceRun == myRun and autoForceState and gui.Parent do
                if jobId == game.JobId then stopForce(); if render then render() end break end
                joinServer(jobId)
                task.wait(FORCE_INTERVAL)
            end
        end)
    end

    -- Toast system
    local toastQueue, toastRunning = {}, false
