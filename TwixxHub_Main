                }, toast)
                corner(bar, 2)
                gradient(bar, ACCENT_HI, ACCENT, 90)
                -- Fixed: set ZIndex directly on instance, not via SetAttribute
                local toastHeader = label(toast, "🐾 New Pet Spotted!", 10, FONT_BOLD, ACCENT_HI,
                    UDim2.fromOffset(20, 6), UDim2.fromOffset(230, 18))
